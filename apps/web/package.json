{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply j4ck-ai --local",
    "db:migrate:remote": "wrangler d1 migrations apply j4ck-ai --remote",
    "sync": "bun ./scripts/sync-home.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@workspace/ui": "workspace:*",
    "@xyflow/react": "^12.11.6",
    "agents": "^0.21.0",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.3.0",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "drizzle-kit": "^0.31.10",
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "wrangler": "^4.125.0"
  }
}
