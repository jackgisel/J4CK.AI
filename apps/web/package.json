{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply j4ck-ai --local",
    "db:migrate:remote": "wrangler d1 migrations apply j4ck-ai --remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@fontsource/russo-one": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6",
    "vite": "^8",
    "vitest": "^4.1.0",
    "wrangler": "^4.125.0"
  }
}
